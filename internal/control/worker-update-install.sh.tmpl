#!/bin/sh
set -eu
[ "$(id -u)" = 0 ] || exit 1
[ -f /etc/cove/node-id ] && [ -x /usr/local/bin/cove-worker ] || { echo 'Enroll this node before enabling updates.' >&2; exit 1; }
command -v cosign >/dev/null || { echo 'Install a trusted Cosign v3+ before enabling updates.' >&2; exit 1; }
command -v flock >/dev/null
command -v curl >/dev/null
command -v jq >/dev/null
cat > /usr/local/sbin/cove-worker-update <<'UPDATER'
{{template "worker-update.sh.tmpl" .}}
UPDATER
chmod 700 /usr/local/sbin/cove-worker-update
cat > /etc/systemd/system/cove-worker-update.service <<'UPDATE_SERVICE'
[Unit]
Description=Update Cove worker to the panel release
After=network-online.target cove-worker.service
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cove-worker-update
TimeoutStartSec=40min
UMask=0077
UPDATE_SERVICE
cat > /etc/systemd/system/cove-worker-update.timer <<'UPDATE_TIMER'
[Unit]
Description=Check for Cove worker updates
[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
RandomizedDelaySec=60
[Install]
WantedBy=timers.target
UPDATE_TIMER
systemctl daemon-reload
systemctl enable --now cove-worker-update.timer
